# The rail's names for the tally's screens, and the side pane's words. The
# screens themselves are in English alone for now.

tally-screen = Tally

# The side pane: the stamps of the activity or the day picked in a heatmap.
tally-side-none = Pick an activity, or a day in its heatmap, to see its stamps.
tally-side-day = Stamps on { $day }
tally-side-range = Stamps from { $from } to { $to }
tally-side-count =
    { $count ->
        [one] 1 stamp
       *[other] { $count } stamps
    }
tally-side-empty = No stamps.
tally-side-clear = Clear
tally-side-show-stamp = Show this stamp
